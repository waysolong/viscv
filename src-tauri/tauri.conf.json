{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ViSCV",
  "version": "0.1.0",
  "identifier": "com.viscv.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1430",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      { "title": "ViSCV — 图像增强可视化", "width": 1280, "height": 820, "minWidth": 960, "minHeight": 640 }
    ],
    "security": { "csp": null }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "resources": ["resources/lenna.png"],
    "externalBin": ["binaries/viscv-engine"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}